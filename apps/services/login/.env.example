PORT=5000

PGHOST=localhost
PGPORT=5432
PGDATABASE=libreria_online
PGUSER=libreria_app
PGPASSWORD=libreria_app_pass

SESSION_SECRET=cambiar-por-clave-secreta-aleatoria

