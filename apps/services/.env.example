# ============================================================
# apps/services/.env.example
# Configuración común para todos los microservicios de la librería
# Copie este archivo como .env y complete con sus credenciales reales
# ============================================================

# --- Base de datos PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=libreria_online
PGUSER=libreria_app
PGPASSWORD=su_password_aqui
PG_POOL_MIN=1
PG_POOL_MAX=10

# --- Redis compartido (Caché, Sesiones, Revocación, Idempotencia) ---
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=1.0
REDIS_CONNECT_TIMEOUT=1.0
REDIS_MAX_CONNECTIONS=20
REDIS_PROTOCOL=2

# --- JWT Seguridad (HS256, 20 minutos de vida, revocación por JTI) ---
JWT_SECRET_KEY=clave-secreta-jwt-minimo-32-caracteres-segura
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=7

# --- TTLs en segundos ---
SESSION_TTL_SECONDS=7200
CACHE_TTL_BOOKS_LIST=300
CACHE_TTL_BOOK_DETAIL=900
CACHE_TTL_AUTHORS=300

# --- Puertos de Microservicios ---
LOGIN_PORT=5000
BOOKS_PORT=5001
USERS_PORT=5002
AUTHORS_PORT=5003
PEDIDOS_PORT=5004
PAGOS_PORT=5005

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://localhost:5001
